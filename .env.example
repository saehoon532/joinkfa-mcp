# Public mode preserves the existing two tools. Do not put credentials here.
KFA_PRIVATE_ENABLED=0
KFA_AUTH_MODE=github
KFA_GITHUB_CLIENT_ID=
KFA_GITHUB_CLIENT_SECRET=
# GitHub mode: immutable numeric GitHub ID. JWT mode: provider subject.
# Private mode requires every setting below and a fresh operator-provisioned session.
KFA_SESSION_FILE=/etc/secrets/kfa-session.json
KFA_OWNER_SUB=your-verified-identity-provider-subject
KFA_JWT_PUBLIC_KEY_FILE=/etc/secrets/mcp-public-key.pem
KFA_JWT_ISSUER=https://your-identity-provider.example/
KFA_JWT_AUDIENCE=https://joinkfa-mcp.onrender.com/mcp
